{
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:4173",
      "http://localhost:8080"
    ]
  },
  "Http": {
    "UseHttpsRedirection": false
  },
  "Jwt": {
    "Issuer": "gym-tracker-api",
    "Audience": "gym-tracker-app",
    "ExpirationHours": 24
  },
  "Wger": {
    "Enabled": true,
    "BaseUrl": "https://wger.de/api/v2/",
    "LanguageId": 2,
    "LanguageCode": "en",
    "PageSize": 50,
    "MaxItems": 1000
  },
  "Nutrition": {
    "UsdaApiKey": "",
    "UsdaBaseUrl": "https://api.nal.usda.gov/fdc/v1/",
    "SearchCacheMinutes": 10,
    "DetailCacheMinutes": 60
  },
  "ExerciseMediaEnrichment": {
    "MaxItems": 500,
    "UrlValidationTimeoutSeconds": 12,
    "Wger": {
      "Enabled": true
    },
    "ExerciseDb": {
      "Enabled": false,
      "BaseUrl": "",
      "ExercisePath": "/exercises",
      "AssetBaseUrl": "",
      "MaxDatasetItems": 2500,
      "RequestHeaders": {}
    },
    "FreeExerciseDb": {
      "Enabled": true,
      "BaseUrl": "https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/",
      "ExercisePath": "dist/exercises.json",
      "AssetBaseUrl": "https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/",
      "MaxDatasetItems": 2500,
      "RequestHeaders": {}
    }
  },
  "MediaStorage": {
    "RootPath": "media",
    "PublicBaseUrl": "http://localhost:8080/media",
    "MaxFileSizeMb": 100
  },
  "MediaGeneration": {
    "Enabled": false,
    "Provider": "OpenAI",
    "MaxJobsPerDay": 10,
    "MaxJobsPerHour": 3,
    "MaxJobsPerDraftPerDay": 2,
    "CooldownSeconds": 120
  },
  "OpenAI": {
    "ApiKey": "",
    "VideoModel": "sora-2",
    "VideoSeconds": 4,
    "VideoSize": "1280x720",
    "TimeoutSeconds": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
