POSTGRES_DB=gymtrackerdb
POSTGRES_USER=gymuser
POSTGRES_PASSWORD=replace-with-a-strong-random-password
POSTGRES_VOLUME_NAME=gym-tracker_gym-tracker-postgres-data
POSTGRES_BACKUP_VOLUME_NAME=gym-tracker_gym-tracker-postgres-backups
POSTGRES_BACKUP_RETENTION_COUNT=7
POSTGRES_BACKUP_INTERVAL_SECONDS=86400
# Required: random secret at least 32 characters long.
JWT_SIGNING_KEY=replace-with-a-random-secret-at-least-32-characters-long
JWT_ISSUER=gym-tracker-api
JWT_AUDIENCE=gym-tracker-app
JWT_EXPIRATION_HOURS=24
Nutrition__UsdaApiKey=
LEGACY_USER_EMAIL=
LEGACY_USER_PASSWORD=
APP_BASE_URL=http://localhost:8080
# Android builds default to https://gym.mediaplexserverbadri.trade. Override only with
# another public HTTPS application origin; the frontend appends /api exactly once.
# VITE_API_BASE_URL=https://gym.example.com
# Capacitor's packaged WebView origin. Keep this fixed and allow it through backend CORS.
CAPACITOR_APP_ORIGIN=https://app.stride.local
WEB_PORT=8080
EXERCISE_MEDIA_VOLUME_NAME=gym-tracker_gym-tracker-exercise-media
MEDIA_STORAGE_MAX_FILE_SIZE_MB=100
MEDIA_GENERATION_ENABLED=false
MEDIA_GENERATION_PROVIDER=OpenAI
MEDIA_GENERATION_MAX_JOBS_PER_DAY=10
MEDIA_GENERATION_MAX_JOBS_PER_HOUR=3
MEDIA_GENERATION_MAX_JOBS_PER_DRAFT_PER_DAY=2
MEDIA_GENERATION_COOLDOWN_SECONDS=120
# AI workout generation remains opt-in; the local catalog-backed planner is the default path.
AI_WORKOUT_GENERATION_ENABLED=false
AI_WORKOUT_GENERATION_PROVIDER=OpenAI
AI_WORKOUT_GENERATION_MAX_CANDIDATE_EXERCISES=60
AI_WORKOUT_GENERATION_TIMEOUT_SECONDS=45
OPENAI_API_KEY=
OPENAI_VIDEO_MODEL=sora-2
OPENAI_VIDEO_SECONDS=4
OPENAI_VIDEO_SIZE=1280x720
OPENAI_TIMEOUT_SECONDS=60
OPENAI_WORKOUT_MODEL=gpt-5-mini
OPENAI_WORKOUT_MAX_OUTPUT_TOKENS=2000
Wger__Enabled=true
Wger__BaseUrl=https://wger.de/api/v2/
Wger__LanguageId=2
Wger__LanguageCode=en
Wger__PageSize=50
Wger__MaxItems=1000
ExerciseMediaEnrichment__MaxItems=250
ExerciseMediaEnrichment__UrlValidationTimeoutSeconds=12
ExerciseMediaEnrichment__Wger__Enabled=true
ExerciseMediaEnrichment__ExerciseDb__Enabled=false
ExerciseMediaEnrichment__ExerciseDb__BaseUrl=
ExerciseMediaEnrichment__ExerciseDb__ExercisePath=/exercises
ExerciseMediaEnrichment__ExerciseDb__AssetBaseUrl=
ExerciseMediaEnrichment__ExerciseDb__MaxDatasetItems=2500
# ExerciseDB remains disabled by default because the current AscendAPI ExerciseDB integration expects a configured host/key flow.
# If you explicitly configure it, also provide any required request headers:
# ExerciseMediaEnrichment__ExerciseDb__RequestHeaders__X-RapidAPI-Key=your-key
# ExerciseMediaEnrichment__ExerciseDb__RequestHeaders__X-RapidAPI-Host=example-host
ExerciseMediaEnrichment__FreeExerciseDb__Enabled=true
ExerciseMediaEnrichment__FreeExerciseDb__BaseUrl=https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/
ExerciseMediaEnrichment__FreeExerciseDb__ExercisePath=dist/exercises.json
ExerciseMediaEnrichment__FreeExerciseDb__AssetBaseUrl=https://raw.githubusercontent.com/yuhonas/free-exercise-db/main/exercises/
ExerciseMediaEnrichment__FreeExerciseDb__MaxDatasetItems=2500
# Example custom headers when a fallback provider needs them:
# ExerciseMediaEnrichment__FreeExerciseDb__RequestHeaders__Authorization=Bearer your-token
